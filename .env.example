# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server-only URLs and OAuth credentials. Never use VITE_ for these values.
FORD_BFF_URL="http://127.0.0.1:3001"
FORD_SERVICE_API_URL="http://localhost:8080"
FORD_SECURITY_ISSUER_URI="https://ford.emme.business"
FORD_BFF_OIDC_CLIENT_ID="ford-web-bff"
FORD_BFF_OIDC_CLIENT_SECRET=""
FORD_BFF_OIDC_REDIRECT_URI="https://ford.emme.business/api/auth/callback"
FORD_BFF_REDIS_URL="redis://localhost:6379"
FORD_PUBLIC_ORIGIN="https://ford.emme.business"
# Set false only for local HTTP BFF development.
FORD_BFF_COOKIE_SECURE="true"
